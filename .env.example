# Copy to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=3000
# Origin allowed to call the API (comma separated for several origins)
WEB_ORIGIN=http://localhost:5173
# PostgreSQL connection string (Docker Compose default below)
DATABASE_URL=postgresql://smartfinance:smartfinance@localhost:5432/smart_finance?schema=public
# Used by integration tests (must be a separate database)
TEST_DATABASE_URL=postgresql://smartfinance:smartfinance@localhost:5432/smart_finance_test?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Set true behind HTTPS in production
COOKIE_SECURE=false
# Python AI service
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=3000
AI_MODEL_VERSION=baseline-tfidf-lr-v1
# Optional LLM for the savings assistant (M2e). OFF by default: with
# LLM_PROVIDER=disabled every answer is generated by deterministic rules from
# the user's own data and nothing leaves the server. Only `anthropic` is
# supported. When enabled, only aggregated savings figures are sent (no
# transactions, notes, emails or tokens) and the UI shows a disclosure notice.
LLM_PROVIDER=disabled
# Required when LLM_PROVIDER=anthropic. Never commit a real key.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=1600
# Enable the optional demo user seed (never enable on public environments)
SEED_DEMO=false
# Days an uncommitted CSV import preview is kept before
# `npm run imports:purge -w @smart-finance/api` (use --dry-run first).
# Defaults to 30 when unset.
IMPORT_PREVIEW_RETENTION_DAYS=30
